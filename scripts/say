#!/usr/bin/env bash
# say — ElevenLabs text-to-speech for voice replies in a task channel, plus the
# per-session "always speak" switch. See docs/voice-replies-spec.md.
#
#   say - <<'EOF'        read the text from stdin (the safe form: no shell
#   …text…               interpolation of the summary), write say-<ts>.mp3
#   EOF                  into the current dir, print its path
#   say --file path      same, text from a file
#   say "text…"          same, text as an argument (only for trivial text)
#   say --on             this channel/session: speak on every reply from now on
#   say --off            stop speaking on every reply
#   say --status         prints "on" or "off" (exit 0 either way)
#
# Identity and paths come from the daemon, which exports them into every
# Claude session it spawns (so a pooled account with its own $HOME changes
# nothing):
#   CLAUDE_THREADS_SPEAK_KEY   the session's key (platformId:threadId, sanitised)
#   CLAUDE_THREADS_SPEAK_DIR   where the switch markers live
#   CLAUDE_THREADS_CONFIG      the daemon config (0600) holding the key and voice
# Run by hand outside a session, the key falls back to the workspace basename
# (`scratch/<ch>` or `worktrees/<ch>--<repo>`, the `workon` rule) and the paths
# to ~/.local/state/claude-threads/speak and ~/.config/claude-threads/config.yaml.
#
# Config: speech.apiKey (falls back to transcription.apiKey), speech.voiceId,
# speech.model. Test overrides: SAY_API_URL, SAY_OUT_DIR.
set -euo pipefail

CONFIG="${CLAUDE_THREADS_CONFIG:-$HOME/.config/claude-threads/config.yaml}"
STATE_DIR="${CLAUDE_THREADS_SPEAK_DIR:-$HOME/.local/state/claude-threads/speak}"
API_URL="${SAY_API_URL:-https://api.elevenlabs.io/v1}"
# The mp3 lands in the workspace because send_file only accepts paths inside
# the session working directory. In a git worktree the pattern is added to
# .git/info/exclude so a stray file can never be WIP-committed at teardown.
OUT_DIR="${SAY_OUT_DIR:-$PWD}"
MAX_CHARS=2500   # ~3 minutes of speech; a spoken reply is a summary, not a report

if [ -n "${CLAUDE_THREADS_SPEAK_KEY:-}" ]; then
  key="$(printf '%s' "$CLAUDE_THREADS_SPEAK_KEY" | tr -c 'A-Za-z0-9._-' '_')"
else
  key="$(basename "$PWD")"; key="${key%%--*}"
  case "$key" in *[!a-z0-9._-]*|"") echo "say: cannot derive a channel from PWD=$PWD and CLAUDE_THREADS_SPEAK_KEY is unset" >&2; exit 2;; esac
fi
marker="$STATE_DIR/$key"

case "${1:-}" in
  --on)     mkdir -p "$STATE_DIR"; : > "$marker"; echo "always speak: on ($key)"; exit 0;;
  --off)    rm -f "$marker"; echo "always speak: off ($key)"; exit 0;;
  --status) if [ -e "$marker" ]; then echo on; else echo off; fi; exit 0;;
  -)        text="$(cat)";;
  --file)   [ -r "${2:-}" ] || { echo "say: --file needs a readable path" >&2; exit 2; }; text="$(cat "$2")";;
  ""|-h|--help) sed -n '2,12p' "$0" >&2; exit 2;;
  *)        text="$1";;
esac

if [ "${#text}" -gt "$MAX_CHARS" ]; then
  echo "say: text is ${#text} chars, limit is $MAX_CHARS — speak a summary, post the rest as text" >&2
  exit 2
fi
if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then
  echo "say: nothing to say (empty text)" >&2
  exit 2
fi

[ -r "$CONFIG" ] || { echo "say: config not readable: $CONFIG" >&2; exit 1; }
# One python call reads the YAML and emits the three settings, one per line
# (an empty value must stay an empty line — a tab-separated read would
# collapse it into its neighbour). Its failure is reported, not swallowed by
# `set -e` mid-read.
settings="$(python3 - "$CONFIG" <<'PY'
import sys, yaml
cfg = yaml.safe_load(open(sys.argv[1])) or {}
speech = cfg.get("speech") or {}
trans = cfg.get("transcription") or {}
print(speech.get("apiKey") or trans.get("apiKey") or "")
print(speech.get("voiceId") or "")
print(speech.get("model") or "eleven_multilingual_v2")
PY
)" || { echo "say: cannot read $CONFIG (python/yaml error above)" >&2; exit 1; }
{ read -r api_key; read -r voice_id; read -r model_id; } <<< "$settings"
[ -n "$api_key" ]  || { echo "say: no ElevenLabs key — set speech.apiKey or transcription.apiKey in $CONFIG" >&2; exit 1; }
[ -n "$voice_id" ] || { echo "say: no voice — set speech.voiceId in $CONFIG" >&2; exit 1; }

out="$OUT_DIR/say-$(date +%Y%m%d-%H%M%S)-$$.mp3"

# Inside a git checkout (worktree or clone): keep say-*.mp3 out of git.
if exclude="$(git -C "$OUT_DIR" rev-parse --path-format=absolute --git-path info/exclude 2>/dev/null)"; then
  mkdir -p "$(dirname "$exclude")"
  grep -qxF 'say-*.mp3' "$exclude" 2>/dev/null || echo 'say-*.mp3' >> "$exclude"
fi

# The key travels in a curl config read from a private fd and the JSON body
# on stdin (the text is passed to python as an argument, never to the shell):
# neither is visible in the process list, and the text is not bound by ARG_MAX.
# A transport failure (timeout, DNS, refused) is reported and leaves no file.
if ! http_code="$(python3 -c 'import json,sys; print(json.dumps({"text": sys.argv[1], "model_id": sys.argv[2]}))' "$text" "$model_id" \
  | curl -sS --max-time 90 -o "$out" -w '%{http_code}' \
      -K <(printf 'header = "xi-api-key: %s"\n' "$api_key") \
      -X POST "$API_URL/text-to-speech/$voice_id?output_format=mp3_44100_128" \
      -H "Content-Type: application/json" \
      -d @-)"; then
  echo "say: request to ElevenLabs failed (curl error above)" >&2
  rm -f "$out"
  exit 1
fi
if [ "$http_code" != "200" ]; then
  echo "say: ElevenLabs HTTP $http_code: $(head -c 300 "$out" 2>/dev/null)" >&2
  rm -f "$out"
  exit 1
fi
echo "$out"
