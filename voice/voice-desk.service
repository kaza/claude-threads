[Unit]
Description=voice-desk — live voice front desk into Slack task channels (Gemini Live)
Documentation=file:///home/herder/claude-threads/docs/voice-desk-spec.md
After=network-online.target
Wants=network-online.target

[Service]
User=herder
WorkingDirectory=/home/herder/claude-threads
EnvironmentFile=/home/herder/.config/voice-desk/env
ExecStart=/home/herder/.bun/bin/bun voice/server.ts
Restart=always
RestartSec=3
# The daemon reads nothing but its own config dir and the claude-threads bindings file.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/herder/.config/voice-desk
PrivateTmp=true

[Install]
WantedBy=multi-user.target
